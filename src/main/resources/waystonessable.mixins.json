{
  "required": true,
  "minVersion": "0.8",
  "package": "com.sshakusora.waystonessable.mixin",
  "compatibilityLevel": "JAVA_21",
  "mixins": [
    "WaystoneBlockBaseMixin",
    "WaystoneBlockEntityBaseMixin"
  ],
  "client": [
    "client.ClientboundStartTrackingSubLevelPacketMixin",
    "client.ClientboundStopTrackingSubLevelPacketMixin",
    "client.ClientPacketListenerMixin"
  ],
